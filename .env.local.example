# Copy to .env.local (git-ignored) and fill in. run-local.sh sources it, so
# you don't have to export these by hand every session.

# Admin sign-in only. Drivers use phone + PIN and need none of this — the
# app is fully usable locally via the dev-login button without it.
# GOOGLE_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com
# EXPO_PUBLIC_GOOGLE_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com

# IANA timezone new businesses default to. Delivery days roll over on this
# clock, not the server's.
# DEFAULT_TIMEZONE=Asia/Kolkata

# Set to 0 to skip Docker Postgres and use in-memory storage instead.
# USE_DOCKER_POSTGRES=0
