# Copy to .env in this directory on the host. Never commit the real file.

# The domain this host serves. Point its A/AAAA record here before starting
# Caddy, or the first Let's Encrypt certificate issue will fail. If you
# proxy through Cloudflare, set the record to DNS-only (grey cloud) until
# the certificate is issued.
DOMAIN=deliveries.example.com
ACME_EMAIL=you@example.com

# Postgres password for the delivery_manager role. Used both to initialize
# the database and to build the backend's DATABASE_URL, so it only needs
# setting in this one place.
# Generate with: openssl rand -base64 32
POSTGRES_PASSWORD=CHANGE_ME

# Generate with: openssl rand -base64 48
JWT_SECRET=CHANGE_ME

# Drivers stay signed in for a fortnight (336h). See the same note in
# ../shared-vps/delivery-manager.env.example for why this is deliberately
# long, and what actually revokes access.
TOKEN_TTL_HOURS=336

# The IANA timezone new businesses default to. Every delivery day rolls
# over on the business's own clock, never the server's.
DEFAULT_TIMEZONE=Asia/Kolkata

# Google Cloud Console OAuth 2.0 Web client ID, for ADMIN sign-in only.
# Not a secret. Leave blank to run without it — drivers sign in with phone
# + PIN regardless, but no admin will be able to sign in, so set this
# before going live.
GOOGLE_CLIENT_ID=
