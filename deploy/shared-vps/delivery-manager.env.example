# Copy to env/delivery-manager.env in the 3vnsystems-infrastructure repo on
# the VPS. Never commit the real file.
# Runtime env for the delivery-manager-backend container only — see
# backend/internal/config/config.go in this repo.

APP_ENV=prod
ADDR=:8080

# Host is "postgres" (the compose service name), not localhost.
# Password must match DELIVERY_MANAGER_POSTGRES_PASSWORD in the root .env.
DATABASE_URL=postgres://delivery_manager:CHANGE_ME_MATCH_ROOT_ENV@postgres:5432/delivery_manager?sslmode=disable

# Generate with: openssl rand -base64 48
JWT_SECRET=CHANGE_ME

# Drivers stay signed in for a fortnight by default (see
# internal/config/environments.go): re-entering a PIN at 5am in the cold is
# exactly the friction that gets an app abandoned, and a driver's token only
# ever unlocks their own round. Deactivating a driver in the admin console
# invalidates their session at the next request, which is the real answer to
# a lost handset.
TOKEN_TTL_HOURS=336

# The IANA timezone new businesses default to. Every delivery day rolls over
# on the business's own clock, never the server's — set this to where the
# rounds actually run.
DEFAULT_TIMEZONE=Asia/Kolkata

# Optional — leave blank to keep admin Google Sign-In disabled. Drivers are
# unaffected either way; they sign in with phone + PIN. Must be the exact
# same value as DELIVERY_MANAGER_GOOGLE_CLIENT_ID in the root .env (used
# there as the frontend image's build arg) — the backend checks it as the
# token audience.
GOOGLE_CLIENT_ID=

# No SMS provider is wired (see backend/internal/notify), so a one-time
# code can only reach this server's log. Sign-in is phone + password
# instead. The OTP code is untouched — removing this line puts its routes
# back the day a provider is configured.
OTP_SIGNIN_DISABLED=1

# The first account, for a deployment where nobody can sign up. Applied
# once at startup and only when that number has no account yet, so a
# restart can never reset a password somebody has since changed.
BOOTSTRAP_BUSINESS=Nalgonda Demo Dairy
BOOTSTRAP_PHONE=9000000000
BOOTSTRAP_PASSWORD=CHANGE_ME
BOOTSTRAP_OWNER=Demo Owner
